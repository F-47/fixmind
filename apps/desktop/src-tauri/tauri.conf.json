{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fixmind",
  "version": "0.1.7",
  "identifier": "dev.fixmind.desktop",
  "build": {
    "beforeDevCommand": "npm run frontend:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run frontend:build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": []
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "F-47",
    "homepage": "https://fixmind.dev",
    "shortDescription": "Local-first learning lessons for developers",
    "longDescription": "Fixmind captures durable lessons from real development work and keeps them available locally.",
    "copyright": "Copyright © 2026 F-47",
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Fixmind",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "externalBin": ["binaries/fixmind-server"],
    "resources": {
      "resources/dashboard/": "dashboard/"
    }
  }
}
